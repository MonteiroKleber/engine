{
  "schema_version": "idl_draft.v1",
  "source": "wizard",
  "project": "atendimento",
  "actors": [
    {
      "id": "Customer",
      "role": "Customer",
      "permissions": ["create_ticket", "view_own_tickets"]
    },
    {
      "id": "Agent",
      "role": "Agent",
      "permissions": ["view_tickets", "resolve_ticket", "escalate_ticket"]
    },
    {
      "id": "Manager",
      "role": "Manager",
      "permissions": ["view_all_tickets", "assign_ticket", "view_reports"]
    }
  ],
  "entities": [
    {
      "id": "Ticket",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "customer_id", "type": "uuid", "required": true},
        {"name": "subject", "type": "string", "required": true},
        {"name": "description", "type": "text", "required": true},
        {"name": "status", "type": "string", "required": true},
        {"name": "priority", "type": "string", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    },
    {
      "id": "Customer",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "email", "type": "string", "required": true},
        {"name": "phone", "type": "string", "required": false},
        {"name": "tier", "type": "string", "required": true}
      ]
    },
    {
      "id": "Agent",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "department", "type": "string", "required": true},
        {"name": "skills", "type": "string", "required": false}
      ]
    },
    {
      "id": "Resolution",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "ticket_id", "type": "uuid", "required": true},
        {"name": "agent_id", "type": "uuid", "required": true},
        {"name": "resolution_text", "type": "text", "required": true},
        {"name": "resolved_at", "type": "datetime", "required": true}
      ]
    }
  ],
  "use_cases": [
    {
      "id": "CreateTicket",
      "actor": "Customer",
      "flow": [
        {"step": 1, "action": "Customer submits ticket with subject and description"},
        {"step": 2, "action": "System validates required fields"},
        {"step": 3, "action": "System assigns priority based on customer tier"},
        {"step": 4, "action": "System creates ticket with open status"}
      ]
    },
    {
      "id": "AssignTicket",
      "actor": "Manager",
      "flow": [
        {"step": 1, "action": "Manager selects ticket from queue"},
        {"step": 2, "action": "Manager selects agent from available pool"},
        {"step": 3, "action": "System validates agent availability"},
        {"step": 4, "action": "System updates ticket status to assigned"}
      ]
    },
    {
      "id": "ResolveTicket",
      "actor": "Agent",
      "flow": [
        {"step": 1, "action": "Agent enters resolution text"},
        {"step": 2, "action": "System validates resolution not empty"},
        {"step": 3, "action": "System creates resolution record"},
        {"step": 4, "action": "System updates ticket status to resolved"}
      ]
    },
    {
      "id": "EscalateTicket",
      "actor": "Agent",
      "flow": [
        {"step": 1, "action": "Agent requests escalation with reason"},
        {"step": 2, "action": "System validates escalation reason"},
        {"step": 3, "action": "System notifies manager"},
        {"step": 4, "action": "System updates ticket priority"}
      ]
    },
    {
      "id": "ListTickets",
      "actor": "Agent",
      "flow": [
        {"step": 1, "action": "User specifies filter criteria"},
        {"step": 2, "action": "System queries tickets matching filters"},
        {"step": 3, "action": "System returns sorted results by priority and date"}
      ]
    }
  ],
  "integrations": []
}
