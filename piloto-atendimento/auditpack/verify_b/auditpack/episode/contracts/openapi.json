components:
  schemas:
    Customer:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        email:
          type: string
        phone:
          type: string
        tier:
          type: string
      required:
      - id
      - name
      - email
      - tier
    Agent:
      type: object
      properties:
        id:
          type: string
        name:
          type: string
        department:
          type: string
        skills:
          type: string
      required:
      - id
      - name
      - department
      - skills
    Resolution:
      type: object
      properties:
        id:
          type: string
        ticket_id:
          type: string
        agent_id:
          type: string
        resolution_text:
          type: string
        resolved_at:
          type: string
      required:
      - id
      - ticket_id
      - agent_id
      - resolution_text
      - resolved_at
    Checkslabreach:
      type: object
      properties:
        id:
          type: string
        manager_verifica_tickets_que_passaram_prazo_sla:
          type: string
      required:
      - id
      - manager_verifica_tickets_que_passaram_prazo_sla
