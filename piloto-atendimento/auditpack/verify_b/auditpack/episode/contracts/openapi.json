openapi: 3.0.0
info:
  title: Sistema Atendimento API
  version: 1.0.0
  description: API gerada automaticamente para Sistema Atendimento
paths:
  /api/customers:
    get:
      operationId: listCustomer
      tags:
      - Customer
      summary: Listar customers
      responses:
        '200':
          description: Lista de customers
        '400':
          description: Bad Request
        '500':
          description: Internal Server Error
    post:
      operationId: createCustomer
      tags:
      - Customer
      summary: Criar customer
      responses:
        '201':
          description: Customer criado
        '400':
          description: Bad Request
        '500':
          description: Internal Server Error
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Customer'
  /api/customers/{id}:
    get:
      operationId: getCustomer
      tags:
      - Customer
      summary: Obter customer por ID
      responses:
        '200':
          description: Detalhes do customer
        '400':
          description: Bad Request
        '500':
          description: Internal Server Error
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
    put:
      operationId: updateCustomer
      tags:
      - Customer
      summary: Atualizar customer
      responses:
        '200':
          description: Customer atualizado
        '400':
          description: Bad Request
        '500':
          description: Internal Server Error
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Customer'
    delete:
      operationId: deleteCustomer
      tags:
      - Customer
      summary: Deletar customer
      responses:
        '200':
          description: Customer deletado
        '400':
          description: Bad Request
        '500':
          description: Internal Server Error
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
