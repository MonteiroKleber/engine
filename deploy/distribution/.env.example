# Bazari Engine Distribution - Environment Variables
# Copy this file to .env and customize as needed
#
# IMPORTANT: This file contains NO secrets. All values are safe defaults.
# For production, create .env with your actual configuration.

# =============================================================================
# Engine Configuration
# =============================================================================

# Engine version (should match VERSION file)
ENGINE_VERSION=1.0.0

# Path to engine source code (relative to docker-compose.yml)
ENGINE_SOURCE=../../

# Path to templates directory
TEMPLATES_ROOT=../../templates

# Root directory for generated projects
GENERATED_ROOT=/tmp/generated

# =============================================================================
# Telemetry & Observability
# =============================================================================

# Enable/disable telemetry (true/false)
TELEMETRY_ENABLED=true

# Telemetry output destination (stdout, file, none)
TELEMETRY_OUTPUT=stdout

# =============================================================================
# Air-Gapped Mode
# =============================================================================

# Enable air-gapped mode - disables all external network calls
ENGINE_AIRGAPPED=false

# Make network internal (no external access) - for strict air-gapped mode
# NETWORK_INTERNAL=true

# =============================================================================
# Wizard Configuration (if enabled)
# =============================================================================

# Directory for wizard sessions
# WIZARD_SESSIONS_DIR=/data/wizard/sessions

# =============================================================================
# Docker/Container Settings
# =============================================================================

# Container restart policy (unless-stopped, always, on-failure, no)
# RESTART_POLICY=unless-stopped

# Log max size per file
# LOG_MAX_SIZE=10m

# Number of log files to keep
# LOG_MAX_FILE=3

# =============================================================================
# Ports (if exposing services externally)
# =============================================================================

# Engine API port (if running HTTP interface)
# ENGINE_PORT=8000

# Wizard API port (if running wizard service)
# WIZARD_PORT=8001

# =============================================================================
# Security Notes
# =============================================================================
#
# 1. Never commit .env files with real secrets to version control
# 2. Use docker secrets or vault for sensitive data in production
# 3. Review volume mounts before production deployment
# 4. Consider running containers as non-root user
#
# For secrets, use environment variables or mount secret files:
#   docker run -e SECRET_KEY_FILE=/run/secrets/key ...
