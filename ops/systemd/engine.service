[Unit]
Description=Libervia Engine - Finance Pilot
After=network.target

[Service]
Type=simple
User=bazari
WorkingDirectory=/home/bazari/engine
EnvironmentFile=/etc/engine/engine.env
Environment=PYTHONPATH=src
ExecStart=/usr/bin/python -m uvicorn engine.api.server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
