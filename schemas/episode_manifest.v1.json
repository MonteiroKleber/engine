{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "episode_manifest.v1.json",
  "title": "Episode Manifest v1",
  "description": "Registro imutável de um episódio de execução (append-only). Cada episódio documenta entrada → contratos → artefatos → (aprovação) → release.\n\n## Campos Nulos Válidos\n\nVários campos permitem null como valor válido:\n\n- **created_by**: null quando episódio é criado automaticamente (sem usuário específico)\n- **contracts.*_hash_sha256**: null quando contrato não foi gerado (ex: idl_hash é null em modo draft)\n- **outputs.repo_hash_sha256**: null até codegen ser executado\n- **outputs.release_artifact_hash_sha256**: null até release ser empacotado\n- **links.previous_episode_id**: null para episódios iniciais (sem histórico)\n- **links.change_request_id**: null quando não há CR associado\n- **links.cr_hash_sha256**: null quando não há CR associado\n- **approval_status**: null antes de qualquer aprovação\n\nCampos nulos NÃO indicam erro. Indicam que aquela etapa ainda não ocorreu ou não se aplica.",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "execution_id",
    "created_at",
    "inputs",
    "contracts",
    "outputs",
    "links",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "episode_manifest.v1",
      "description": "Versão fixa do schema"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único do episódio (determinístico por execução)"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID da execução do engine que gerou este episódio"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de criação do episódio (ISO 8601)"
    },
    "created_by": {
      "type": ["string", "null"],
      "description": "Identificador de quem criou o episódio. Null quando criado automaticamente pelo engine."
    },
    "inputs": {
      "$ref": "#/definitions/inputs",
      "description": "Informações sobre os inputs do episódio"
    },
    "contracts": {
      "$ref": "#/definitions/contracts",
      "description": "Hashes dos contratos gerados"
    },
    "outputs": {
      "$ref": "#/definitions/outputs",
      "description": "Hashes dos outputs/artefatos gerados"
    },
    "links": {
      "$ref": "#/definitions/links",
      "description": "Links para episódios relacionados"
    },
    "integrity": {
      "$ref": "#/definitions/integrity",
      "description": "Integridade do episódio (hash raiz)"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "released"],
      "description": "Status do episódio baseado nas aprovações"
    },
    "approval_status": {
      "type": ["object", "null"],
      "description": "Resumo do status de aprovação",
      "additionalProperties": false,
      "properties": {
        "has_approval": {
          "type": "boolean",
          "description": "Se existe approval.json no episódio"
        },
        "decision": {
          "type": ["string", "null"],
          "enum": [null, "approve", "reject"],
          "description": "Decisão da aprovação"
        },
        "approver_name": {
          "type": ["string", "null"],
          "description": "Nome do aprovador"
        }
      }
    }
  },
  "definitions": {
    "inputs": {
      "type": "object",
      "required": ["input_mode", "input_hash_sha256"],
      "additionalProperties": false,
      "properties": {
        "input_mode": {
          "type": "string",
          "enum": ["natural", "draft", "idl"],
          "description": "Modo de entrada do episódio"
        },
        "input_hash_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash SHA256 do input canonicalizado"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idl_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do IDL. Null quando input_mode != 'idl' (modos draft/natural nao geram IDL)."
        },
        "srs_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do SRS"
        },
        "ir_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do IR"
        },
        "openapi_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do OpenAPI"
        },
        "plan_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do Plan"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do repositório gerado. Null até codegen ser executado com sucesso."
        },
        "release_artifact_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash do artefato de release. Null até release ser empacotado e publicado."
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_episode_id": {
          "type": ["string", "null"],
          "description": "ID do episódio anterior. Null para episódios iniciais (primeira geracao, sem historico)."
        },
        "change_request_id": {
          "type": ["string", "null"],
          "description": "ID de um change request externo. Null quando episodio nao tem CR associado (geracao inicial)."
        },
        "cr_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash SHA256 do Change Request. Null quando nao ha CR associado ao episodio."
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["episode_root_hash_sha256", "algorithm"],
      "additionalProperties": false,
      "properties": {
        "episode_root_hash_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash raiz do episódio (derivado de todos os arquivos)"
        },
        "algorithm": {
          "type": "string",
          "const": "sha256",
          "description": "Algoritmo de hash usado"
        },
        "file_hashes": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["path", "hash"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "Caminho relativo do arquivo"
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$",
                "description": "Hash SHA256 do arquivo"
              }
            }
          },
          "description": "Lista ordenada de arquivos e seus hashes"
        }
      }
    }
  }
}
