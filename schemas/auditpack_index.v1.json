{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auditpack_index.v1.json",
  "title": "AuditPack Index v1",
  "description": "Índice canônico de um pacote de auditoria. Contém hashes de todos os arquivos incluídos e um root_hash derivado.",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "files",
    "root_hash_sha256",
    "algorithm"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "auditpack_index.v1",
      "description": "Versão fixa do schema"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID do episódio auditado"
    },
    "execution_id": {
      "type": ["string", "null"],
      "description": "ID da execução (geralmente igual ao episode_id)"
    },
    "created_at_volatile": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp de criação do auditpack (volátil, não incluído no hash)"
    },
    "source_episode_root_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash raiz do episódio fonte (do manifest original)"
    },
    "files": {
      "type": "array",
      "description": "Lista de arquivos incluídos no pack, ordenada por path",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Caminho relativo do arquivo dentro do zip"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "description": "Hash SHA256 do arquivo"
          },
          "size_bytes": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "Tamanho do arquivo em bytes"
          }
        }
      }
    },
    "root_hash_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash raiz derivado da concatenação ordenada de path:hash"
    },
    "algorithm": {
      "type": "string",
      "const": "sha256",
      "description": "Algoritmo de hash usado"
    },
    "include_artifacts": {
      "type": "boolean",
      "description": "Se artefatos foram incluídos no pack"
    },
    "stats": {
      "type": ["object", "null"],
      "description": "Estatísticas do pack",
      "additionalProperties": false,
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0,
          "description": "Número total de arquivos"
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Tamanho total em bytes"
        },
        "has_approval": {
          "type": "boolean",
          "description": "Se o pack inclui approval"
        },
        "has_change_request": {
          "type": "boolean",
          "description": "Se o pack inclui change_request"
        },
        "has_legacy_verify": {
          "type": "boolean",
          "description": "Se o pack inclui legacy_verify"
        }
      }
    }
  }
}
