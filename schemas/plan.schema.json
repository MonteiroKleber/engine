{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan.schema.json",
  "title": "Implementation Plan",
  "description": "Plano de implementacao gerado a partir do IR",
  "type": "object",
  "required": ["meta", "tasks"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "strategy"],
      "properties": {
        "version": {
          "type": "string",
          "description": "Versao do plano (ex: v1)"
        },
        "strategy": {
          "type": "string",
          "enum": ["PATCH_ONLY"],
          "description": "Estrategia de aplicacao do plano"
        },
        "ir_version": {
          "type": "string",
          "description": "Versao do IR de origem"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criacao"
        },
        "project_name": {
          "type": "string",
          "description": "Nome do projeto"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "files", "acceptance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task_[a-z0-9_]+$",
            "description": "Identificador unico da task (ex: task_create_user_model)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Titulo descritivo da task"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "Ordem de execucao (1-based)"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "Caminho do arquivo a ser criado/modificado"
            },
            "description": "Lista de arquivos afetados pela task"
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "Criterio de aceitacao"
            },
            "description": "Lista de criterios de aceitacao para a task"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "ID de task que deve ser completada antes"
            },
            "description": "Lista de dependencias (IDs de outras tasks)"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "skipped"],
            "default": "pending",
            "description": "Status atual da task"
          }
        }
      }
    }
  }
}
