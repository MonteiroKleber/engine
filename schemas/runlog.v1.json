{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runlog.v1.json",
  "title": "Engine Runlog v1",
  "description": "Runlog do engine para rastreamento de execuções. Inclui referências ao Change Request quando aplicável.",
  "type": "object",
  "required": [
    "schema_version",
    "execution_id",
    "final_status",
    "duration_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "runlog.v1",
      "description": "Versão fixa do schema"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único da execução"
    },
    "final_status": {
      "type": "string",
      "enum": ["success", "blocked", "failed"],
      "description": "Status final da execução"
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "OPEN_QUESTIONS_BLOCKING",
        "SCHEMA_INVALID",
        "INCOMPLETE_STEPS",
        "APPROVAL_REQUIRED",
        "APPROVAL_INVALID",
        "IMPACT_OUT_OF_SCOPE",
        "IMPACT_TOO_BROAD",
        "IMPACT_FORBIDDEN_PATH",
        "IMPACT_GATE_BLOCKED",
        "CR_PREVIOUS_MISMATCH"
      ],
      "description": "Razão do bloqueio (null se success/failed)"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Duração da execução em milissegundos"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de mensagens de erro"
    },
    "error_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de códigos de erro (1:1 com errors)"
    },
    "change_request": {
      "type": ["object", "null"],
      "description": "Referências do Change Request (null se não for execução 'change')",
      "additionalProperties": false,
      "properties": {
        "change_request_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID do Change Request"
        },
        "previous_episode_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID do episódio anterior (base)"
        },
        "cr_hash_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash SHA256 do CR canonicalizado"
        }
      },
      "required": ["change_request_id", "previous_episode_id", "cr_hash_sha256"]
    },
    "metrics": {
      "type": ["object", "null"],
      "description": "Métricas da execução",
      "properties": {
        "input_mode": {
          "type": "string",
          "enum": ["natural", "draft", "idl"],
          "description": "Modo de entrada"
        },
        "artifacts_generated": {
          "type": "integer",
          "minimum": 0,
          "description": "Número de artefatos gerados"
        },
        "patches_applied": {
          "type": "integer",
          "minimum": 0,
          "description": "Número de patches aplicados"
        }
      }
    },
    "volatile": {
      "type": ["object", "null"],
      "description": "Dados voláteis (não incluídos em verificações de integridade)",
      "properties": {
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp de início (ISO 8601)"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Timestamp de término (ISO 8601)"
        }
      }
    }
  }
}
