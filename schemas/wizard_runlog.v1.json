{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wizard_runlog.v1.json",
  "title": "Wizard RunLog v1",
  "description": "RunLog canônico para auditoria do funil de entrada do Wizard",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "mode",
    "final_status",
    "blocked_reason",
    "duration_ms",
    "counts",
    "flags",
    "errors",
    "error_codes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "wizard_runlog.v1",
      "description": "Versão fixa do schema"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador da sessão do wizard"
    },
    "mode": {
      "type": "string",
      "enum": ["start", "resume", "export"],
      "description": "Modo de operação do wizard"
    },
    "final_status": {
      "type": "string",
      "enum": ["success", "blocked", "invalid"],
      "description": "Status final da execução"
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "enum": [null, "OPEN_QUESTIONS_BLOCKING", "SCHEMA_INVALID", "INCOMPLETE_STEPS", "APPROVAL_REQUIRED", "APPROVAL_INVALID", "IMPACT_OUT_OF_SCOPE", "IMPACT_TOO_BROAD", "IMPACT_FORBIDDEN_PATH", "IMPACT_GATE_BLOCKED"],
      "description": "Razão do bloqueio (null se success)"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Duração da execução em milissegundos"
    },
    "counts": {
      "type": "object",
      "required": [
        "steps_total",
        "steps_complete",
        "open_questions_total",
        "open_questions_blocking",
        "evidence_total"
      ],
      "additionalProperties": false,
      "properties": {
        "steps_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total de steps no wizard"
        },
        "steps_complete": {
          "type": "integer",
          "minimum": 0,
          "description": "Steps com status complete"
        },
        "open_questions_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total de open questions"
        },
        "open_questions_blocking": {
          "type": "integer",
          "minimum": 0,
          "description": "Open questions com severity blocking"
        },
        "evidence_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total de evidências anexadas"
        }
      }
    },
    "flags": {
      "type": "object",
      "required": ["has_blocking_open_questions", "has_evidence"],
      "additionalProperties": false,
      "properties": {
        "has_blocking_open_questions": {
          "type": "boolean",
          "description": "True se existem open questions blocking"
        },
        "has_evidence": {
          "type": "boolean",
          "description": "True se existem evidências"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de mensagens de erro"
    },
    "error_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de códigos de erro (1:1 com errors)"
    },
    "blueprint": {
      "type": ["object", "null"],
      "description": "Informações do blueprint aplicado (null se não usado)",
      "additionalProperties": false,
      "properties": {
        "blueprint_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID do blueprint usado"
        },
        "content_hash_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash SHA256 do blueprint canonicalizado"
        },
        "diff_summary": {
          "type": "object",
          "description": "Resumo determinístico das mudanças aplicadas",
          "additionalProperties": false,
          "properties": {
            "filled_fields": {
              "type": "integer",
              "minimum": 0,
              "description": "Número de campos preenchidos pelo blueprint"
            },
            "filled_sections": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Seções preenchidas (actors, entities, etc)"
            }
          },
          "required": ["filled_fields", "filled_sections"]
        }
      },
      "required": ["blueprint_id", "content_hash_sha256", "diff_summary"]
    },
    "episode": {
      "type": ["object", "null"],
      "description": "Referências de auditoria do episódio (null se não associado a episódio)",
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador do episódio"
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1,
          "description": "Caminho relativo para o manifest do episódio"
        },
        "episode_root_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash raiz do episódio (null se não finalizado)"
        },
        "approval": {
          "type": "object",
          "description": "Status da aprovação do episódio",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean",
              "description": "True se existe approval.json"
            },
            "decision": {
              "type": ["string", "null"],
              "enum": ["approve", "reject", null],
              "description": "Decisão da aprovação (null se não presente)"
            },
            "approval_hash_sha256": {
              "type": ["string", "null"],
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Hash SHA256 do approval.json canonicalizado (null se não presente)"
            }
          },
          "required": ["present", "decision", "approval_hash_sha256"]
        }
      },
      "required": ["episode_id", "manifest_path", "episode_root_hash_sha256", "approval"]
    }
  }
}
