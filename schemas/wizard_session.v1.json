{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wizard_session.v1.json",
  "title": "Wizard Session v1",
  "description": "Contrato para sessão de entrada assistida determinística que gera IDL Draft v1",
  "type": "object",
  "required": ["schema_version", "session_id", "project", "steps", "evidence", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "wizard_session.v1",
      "description": "Versão fixa do schema"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único da sessão"
    },
    "project": {
      "type": "object",
      "required": ["name", "domain"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Nome do projeto/sistema"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "Domínio de negócio"
        },
        "objective": {
          "type": "string",
          "description": "Objetivo principal do sistema"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      },
      "description": "Lista de passos do wizard"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/evidence_item"
      },
      "description": "Lista de evidências/anexos"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/open_question"
      },
      "description": "Lista de perguntas pendentes"
    },
    "blueprint_ref": {
      "type": ["object", "null"],
      "description": "Referência opcional a um blueprint para pré-preenchimento do draft",
      "additionalProperties": false,
      "properties": {
        "blueprint_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID do blueprint no registry"
        },
        "registry_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash SHA256 do blueprint no registry (para auditoria)"
        }
      },
      "required": ["blueprint_id"]
    },
    "volatile": {
      "type": "object",
      "additionalProperties": true,
      "description": "Campos voláteis que NÃO influenciam output determinístico",
      "properties": {
        "created_at": {
          "type": ["string", "null"],
          "description": "Timestamp de criação (ISO 8601)"
        },
        "updated_at": {
          "type": ["string", "null"],
          "description": "Timestamp de última atualização (ISO 8601)"
        },
        "client_info": {
          "type": ["object", "null"],
          "description": "Informações do cliente (browser, versão, etc)"
        }
      }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["step_id", "title", "status", "fields"],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único do step"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Título do step"
        },
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "blocked"],
          "description": "Status de completude do step"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "Lista de campos do step"
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["field_id", "required"],
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único do campo dentro do step"
        },
        "label": {
          "type": "string",
          "description": "Label de exibição do campo"
        },
        "value": {
          "description": "Valor do campo (qualquer tipo JSON válido)"
        },
        "required": {
          "type": "boolean",
          "description": "Se o campo é obrigatório"
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "required": ["evidence_id", "kind", "path"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único da evidência"
        },
        "kind": {
          "type": "string",
          "enum": ["ddl", "csv", "doc", "link", "note", "spreadsheet", "diagram"],
          "description": "Tipo de evidência"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Caminho ou referência da evidência"
        },
        "content_hash_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash SHA256 do conteúdo (quando disponível)"
        },
        "description": {
          "type": "string",
          "description": "Descrição opcional da evidência"
        }
      }
    },
    "open_question": {
      "type": "object",
      "required": ["question_id", "question", "severity"],
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador único da pergunta"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "Texto da pergunta"
        },
        "context": {
          "type": ["string", "null"],
          "description": "Contexto adicional da pergunta"
        },
        "severity": {
          "type": "string",
          "enum": ["blocking", "non_blocking"],
          "description": "Severidade: blocking impede geração de IDL Draft"
        }
      }
    }
  }
}
