{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blueprint_registry.v1.json",
  "title": "Blueprint Registry v1",
  "description": "Registry index for blueprints with versioning and content hashes for integrity verification.",
  "type": "object",
  "required": ["schema_version", "blueprints"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "blueprint_registry.v1",
      "description": "Fixed schema version"
    },
    "blueprints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/registry_entry"
      },
      "description": "List of registered blueprints (sorted by blueprint_id)"
    }
  },
  "definitions": {
    "registry_entry": {
      "type": "object",
      "required": ["blueprint_id", "path", "content_hash_sha256", "domain", "version"],
      "additionalProperties": false,
      "properties": {
        "blueprint_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "description": "Unique identifier of the blueprint"
        },
        "path": {
          "type": "string",
          "pattern": "^blueprints/[a-z][a-z0-9_.-]*\\.json$",
          "description": "Relative path to blueprint file (blueprints/<id>.json)"
        },
        "content_hash_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA256 hash of canonicalized blueprint content"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "Domain of the blueprint"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version of the blueprint"
        }
      }
    }
  }
}
