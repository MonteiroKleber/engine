{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blueprint.schema.json",
  "title": "Blueprint",
  "type": "object",
  "required": ["id", "type", "components"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Identificador único do blueprint"
    },
    "type": {
      "type": "string",
      "description": "Tipo do blueprint"
    },
    "version": {
      "type": "string",
      "description": "Versão do blueprint"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
