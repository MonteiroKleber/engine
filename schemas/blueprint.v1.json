{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blueprint.v1.json",
  "title": "Blueprint v1",
  "description": "Blueprint para pré-preenchimento de IDL Draft. Contém sugestões de domínio que NÃO substituem input humano.",
  "type": "object",
  "required": ["schema_version", "blueprint_id", "title", "domain", "version", "compat", "defaults"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "blueprint.v1",
      "description": "Versão fixa do schema"
    },
    "blueprint_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "description": "Identificador único do blueprint (ex: marketplace.v1.core)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Título legível do blueprint"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Domínio de negócio (ex: marketplace, clinic, finance)"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Versão semântica do blueprint (ex: 1.0.0)"
    },
    "compat": {
      "type": "object",
      "required": ["idl_draft_schema_version"],
      "additionalProperties": false,
      "properties": {
        "idl_draft_schema_version": {
          "type": "string",
          "description": "Versão do IDL Draft compatível"
        },
        "idl_schema_version": {
          "type": "string",
          "description": "Versão do IDL compatível (opcional)"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Valores padrão sugeridos para IDL Draft",
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actor"
          },
          "description": "Atores sugeridos"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entity"
          },
          "description": "Entidades sugeridas"
        },
        "usecases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/usecase"
          },
          "description": "Casos de uso sugeridos"
        },
        "integrations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/integration"
          },
          "description": "Integrações sugeridas"
        },
        "nonfunctional": {
          "$ref": "#/definitions/nonfunctional",
          "description": "Requisitos não-funcionais sugeridos"
        }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Notas adicionais sobre o blueprint"
    }
  },
  "definitions": {
    "actor": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador do ator"
        },
        "role": {
          "type": "string",
          "description": "Papel/função do ator"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Permissões do ator"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador da entidade"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "description": "Campos da entidade"
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Nome do campo"
        },
        "type": {
          "type": "string",
          "description": "Tipo do campo (ex: string, integer, date)"
        },
        "required": {
          "type": ["boolean", "string"],
          "description": "Se o campo é obrigatório (pode ser 'unknown')"
        }
      }
    },
    "usecase": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador do caso de uso"
        },
        "actor": {
          "type": "string",
          "description": "Ator principal"
        },
        "flow": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/flow_step"
          },
          "description": "Passos do fluxo"
        }
      }
    },
    "flow_step": {
      "type": "object",
      "required": ["step", "action"],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "description": "Número do passo"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "Descrição da ação"
        }
      }
    },
    "integration": {
      "type": "object",
      "required": ["system"],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "description": "Nome do sistema externo"
        },
        "type": {
          "type": "string",
          "enum": ["api", "db", "queue", "unknown"],
          "description": "Tipo de integração"
        }
      }
    },
    "nonfunctional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performance": {
          "type": "string",
          "description": "Requisitos de performance"
        },
        "security": {
          "type": "string",
          "description": "Requisitos de segurança"
        },
        "availability": {
          "type": "string",
          "description": "Requisitos de disponibilidade"
        },
        "scalability": {
          "type": "string",
          "description": "Requisitos de escalabilidade"
        }
      }
    }
  }
}
