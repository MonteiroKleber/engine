  "separation_of_duties": [
    {
      "forbid": {
        "action": "Decide",
        "when": {
          "kind": "compare",
          "lhs": {
            "ref": "actor.id",
            "type": "unknown"
          },
          "op": "==",
          "rhs": {
            "ref": "report.created_by",
            "type": "unknown"
          }
        }
      },
      "message": "Denunciante nao pode decidir o caso da propria denuncia.",
      "name": "ReporterCannotDecide",
      "on_entity": "ModerationAction",
      "severity": "critical"
    },
    {
      "forbid": {
        "action": "Decide",
        "when": {
          "kind": "compare",
          "lhs": {
            "ref": "actor.id",
            "type": "unknown"
          },
          "op": "==",
          "rhs": {
            "ref": "ModerationAction.proposed_by",
            "type": "unknown"
          }
        }
      },
      "message": "Proponente da acao nao pode aprovar/rejeitar a propria proposta.",
      "name": "ProposerCannotDecide",
      "on_entity": "ModerationAction",
      "severity": "critical"
    },
    {
      "forbid": {
        "action": "Apply",
        "when": {
          "exprs": [
            {
              "kind": "compare",
              "lhs": {
                "ref": "actor.id",
                "type": "unknown"
              },
              "op": "==",
              "rhs": {
                "ref": "ModerationAction.proposed_by",
                "type": "unknown"
              }
            },
            {
              "exprs": [
                {
                  "kind": "compare",
                  "lhs": {
                    "ref": "ModerationAction.action",
                    "type": "unknown"
                  },
                  "op": "==",
                  "rhs": {
                    "lit": "BAN",
                    "type": "string"
                  }
                },
                {
                  "kind": "compare",
                  "lhs": {
                    "ref": "ModerationAction.action",
                    "type": "unknown"
                  },
                  "op": "==",
                  "rhs": {
                    "lit": "REMOVE",
                    "type": "string"
                  }
                },
                {
                  "kind": "compare",
                  "lhs": {
                    "ref": "ModerationAction.action",
                    "type": "unknown"
                  },
                  "op": "==",
                  "rhs": {
                    "lit": "SHADOWBAN",
                    "type": "string"
                  }
                }
              ],
              "kind": "or"
            }
          ],
          "kind": "and"
        }
      },
      "message": "Proponente de acao irreversivel nao pode aplicar a propria proposta.",
      "name": "ProposerCannotApply",
      "on_entity": "ModerationAction",
      "severity": "high"
    }
  ],
