  "system": {
    "contact": "ops@bazari.libervia.xyz",
    "description": "Governanca de moderacao para social e chat com approvals, SoD e auditoria.",
    "domain": "moderation",
    "id": "BazariMVP",
    "name": "Bazari MVP - Governanca de Moderacao",
    "owner": "Bazari"
  },
  "workflows": [
    {
      "name": "ReportFlow",
      "on_entity": "ContentReport",
      "state_field": "state",
      "states": [
        {
          "initial": true,
          "name": "Pending",
          "terminal": false
        },
        {
          "initial": false,
          "name": "Triaged",
          "terminal": false
        },
        {
          "initial": false,
          "name": "Resolved",
          "terminal": true
        },
        {
          "initial": false,
          "name": "Dismissed",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Triaged"
            },
            {
              "kind": "set_field"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Pending",
          "guard": {
            "lit": true,
            "type": "bool"
          },
          "name": "Triage",
          "to": "Triaged"
        },
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Resolved"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Triaged",
          "guard": {
            "lit": true,
            "type": "bool"
          },
          "name": "Resolve",
          "to": "Resolved"
        },
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Dismissed"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Triaged",
          "guard": {
            "lit": true,
            "type": "bool"
          },
          "name": "Dismiss",
          "to": "Dismissed"
        }
      ]
    },
    {
      "name": "ModerationActionFlow",
