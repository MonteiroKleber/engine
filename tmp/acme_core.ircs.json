  "system": {
    "id": "AcmeCore",
    "name": "Acme Core",
    "description": "Multi-department governance for Acme Foods Distribution",
    "domain": "finance",
    "owner": "Acme Foods",
    "contact": "ops@acmefoods.example"
  },
  "department": {
    "dept_id": "finance",
    "name": "Acme Core",
    "namespace": "finance",
    "tenancy": "multi",
    "entrypoints": {
      "api_prefix": "/finance",
      "permission_prefix": "finance.",
      "event_prefix": "finance."
    }
  },
  "policy_context": {
    "schema": [
      {
        "name": "jurisdiction",
        "type": "string",
        "required": true
      },
      {
        "name": "risk_level",
        "type": "string",
        "required": false,
        "default": "low"
      },
      {
        "name": "amount_threshold",
        "type": "decimal",
        "required": false,
        "default": 1000
      }
    ]
  },
  "actors": [
    {
      "kind": "human",
      "id": "operator",
      "name": "Operator",
      "description": "Creates expenses and purchase requests",
      "auth": "token",
      "permissions": [
        "finance.expense.create",
        "finance.expense.read",
        "finance.expense.submit",
        "procurement.purchase_request.create",
        "procurement.purchase_request.read",
        "ops.goods_received.create",
        "ops.goods_received.read"
      ]
    },
    {
      "kind": "human",
      "id": "manager",
      "name": "Manager",
      "description": "Approves expenses and purchase requests",
      "auth": "token",
      "permissions": [
        "finance.expense.read",
        "finance.expense.approve",
        "finance.expense.transition",
        "procurement.purchase_request.read",
        "procurement.purchase_request.approve"
      ]
    },
    {
      "kind": "human",
      "id": "controller",
      "name": "Controller",
      "description": "Financial controller with elevated permissions",
      "auth": "token",
      "permissions": [
        "finance.expense.read",
        "finance.expense.approve",
        "finance.expense.reject",
        "procurement.purchase_request.read",
        "procurement.purchase_request.approve",
        "ops.goods_received.read",
        "ops.goods_received.confirm"
      ]
    },
    {
      "kind": "system",
      "id": "runtime",
      "name": "Runtime",
      "description": "",
      "auth": "token",
      "permissions": [
        "runtime.bundle.load",
        "runtime.proof.snapshot",
        "runtime.safe_mode.enter"
      ]
    },
    {
      "kind": "system",
      "id": "finance_bot",
      "name": "Finance Bot",
      "description": "AI agent for finance operations with limited permissions",
      "auth": "token",
      "permissions": [
        "finance.expense.read",
        "finance.expense.create"
      ]
    }
  ],
  "entities": [
