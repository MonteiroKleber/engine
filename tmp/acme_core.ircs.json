        "tenant_field": "tenant_id",
        "version_field": "version"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "unique": true
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "amount",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "currency",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "text",
          "required": true
        },
        {
          "name": "category",
          "type": "string",
          "required": true
        },
        {
          "name": "created_by",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true
        },
        {
          "name": "state",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "name": "version",
          "type": "int",
          "required": true,
          "default": 1
        }
      ]
    },
    {
      "name": "PurchaseRequest",
      "storage": {
        "tenant_field": "tenant_id",
        "version_field": "version"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "unique": true
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "amount",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "currency",
          "type": "string",
          "required": true
        },
        {
          "name": "vendor",
          "type": "string",
          "required": true
        },
        {
          "name": "items",
          "type": "text",
          "required": true
        },
        {
          "name": "urgency",
          "type": "string",
          "required": true,
          "default": "normal"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true
        },
        {
          "name": "state",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "name": "version",
          "type": "int",
          "required": true,
          "default": 1
        }
      ]
    },
    {
      "name": "GoodsReceived",
      "storage": {
        "tenant_field": "tenant_id",
        "version_field": "version"
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "unique": true
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "purchase_request_id",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "received_by",
          "type": "uuid",
          "required": true,
          "indexed": true
        },
        {
          "name": "received_at",
          "type": "datetime",
          "required": true
        },
        {
          "name": "condition",
          "type": "string",
          "required": true,
          "default": "good"
        },
        {
          "name": "notes",
          "type": "text",
          "required": false
        },
        {
          "name": "state",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "name": "version",
          "type": "int",
          "required": true,
          "default": 1
        }
      ]
    }
  ],
  "invariants": [
    {
      "name": "ExpensePositiveAmount",
      "applies_to": "Expense",
      "when": {
        "kind": "always"
      },
      "assert": {
        "kind": "compare",
        "op": ">",
        "lhs": {
          "ref": "Expense.amount",
          "type": "unknown"
        },
        "rhs": {
          "lit": 0,
          "type": "int"
        }
      },
      "severity": "critical",
      "message": "Expense amount must be positive."
    },
    {
      "name": "ExpenseMustHaveCurrency",
      "applies_to": "Expense",
      "when": {
        "kind": "always"
      },
      "assert": {
        "kind": "compare",
        "op": "!=",
        "lhs": {
          "ref": "Expense.currency",
          "type": "unknown"
        },
        "rhs": {
          "lit": "",
          "type": "string"
        }
      },
      "severity": "high",
      "message": "Expense currency must be defined."
    },
    {
      "name": "PurchaseRequestPositiveAmount",
      "applies_to": "PurchaseRequest",
      "when": {
        "kind": "always"
      },
      "assert": {
        "kind": "compare",
        "op": ">",
        "lhs": {
          "ref": "PurchaseRequest.amount",
          "type": "unknown"
        },
        "rhs": {
          "lit": 0,
          "type": "int"
        }
      },
      "severity": "critical",
      "message": "Purchase request amount must be positive."
    },
    {
      "name": "GoodsReceivedValidCondition",
      "applies_to": "GoodsReceived",
      "when": {
        "kind": "always"
      },
      "assert": {
        "kind": "compare",
        "op": "!=",
        "lhs": {
          "ref": "GoodsReceived.condition",
          "type": "unknown"
        },
        "rhs": {
          "lit": "",
          "type": "string"
        }
      },
      "severity": "high",
      "message": "Goods condition must be specified."
    }
  ],
  "separation_of_duties": [
    {
      "name": "NoSelfApprovalExpense",
      "on_entity": "Expense",
      "forbid": {
        "action": "Approve",
        "when": {
          "kind": "compare",
          "op": "==",
          "lhs": {
            "ref": "actor.id",
            "type": "unknown"
          },
          "rhs": {
            "ref": "Expense.created_by",
            "type": "unknown"
          }
        }
      },
      "severity": "critical",
      "message": "Creator cannot approve their own expense."
    },
    {
      "name": "NoSelfApprovalPurchase",
      "on_entity": "PurchaseRequest",
      "forbid": {
        "action": "Approve",
        "when": {
          "kind": "compare",
          "op": "==",
          "lhs": {
            "ref": "actor.id",
            "type": "unknown"
          },
          "rhs": {
            "ref": "PurchaseRequest.created_by",
            "type": "unknown"
          }
        }
      },
      "severity": "critical",
      "message": "Creator cannot approve their own purchase request."
    }
  ],
  "workflows": [
    {
      "name": "ExpenseFlow",
      "on_entity": "Expense",
      "state_field": "state",
      "states": [
        {
          "name": "Draft",
          "initial": true,
          "terminal": false
        },
        {
          "name": "PendingApproval",
          "initial": false,
          "terminal": false
        },
        {
          "name": "Approved",
          "initial": false,
          "terminal": true
        },
        {
          "name": "Rejected",
          "initial": false,
          "terminal": true
        }
      ],
      "transitions": [
        {
          "name": "Submit",
          "from": "Draft",
          "to": "PendingApproval",
          "guard": {
            "kind": "compare",
            "op": ">",
            "lhs": {
              "ref": "Expense.amount",
              "type": "unknown"
            },
            "rhs": {
              "lit": 0,
              "type": "int"
            }
          },
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "PendingApproval"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        },
        {
          "name": "Approve",
          "from": "PendingApproval",
          "to": "Approved",
          "guard": {
            "kind": "always"
          },
          "approvals": {
            "quorum": 1,
            "roles": [
              "manager",
              "controller"
            ],
            "distinct_actors": true,
            "expires_in": "48h"
          },
          "effects": [
            {
              "kind": "set_state",
              "value": "Approved"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        },
        {
          "name": "Reject",
          "from": "PendingApproval",
          "to": "Rejected",
          "guard": {
            "kind": "always"
          },
          "approvals": {
            "quorum": 1,
            "roles": [
              "manager",
              "controller"
            ],
            "distinct_actors": true,
            "expires_in": "48h"
          },
          "effects": [
            {
              "kind": "set_state",
              "value": "Rejected"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        }
      ]
    },
    {
      "name": "PurchaseFlow",
      "on_entity": "PurchaseRequest",
      "state_field": "state",
      "states": [
        {
          "name": "Draft",
          "initial": true,
          "terminal": false
        },
        {
          "name": "PendingApproval",
          "initial": false,
          "terminal": false
        },
        {
          "name": "Approved",
          "initial": false,
          "terminal": true
        },
        {
          "name": "Rejected",
          "initial": false,
          "terminal": true
        }
      ],
      "transitions": [
        {
          "name": "Submit",
          "from": "Draft",
          "to": "PendingApproval",
          "guard": {
            "kind": "compare",
            "op": ">",
            "lhs": {
              "ref": "PurchaseRequest.amount",
              "type": "unknown"
            },
            "rhs": {
              "lit": 0,
              "type": "int"
            }
          },
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "PendingApproval"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        },
        {
          "name": "Approve",
          "from": "PendingApproval",
          "to": "Approved",
          "guard": {
            "kind": "always"
          },
          "approvals": {
            "quorum": 1,
            "roles": [
              "manager",
              "controller"
            ],
            "distinct_actors": true,
            "expires_in": "72h"
          },
          "effects": [
            {
              "kind": "set_state",
              "value": "Approved"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        },
        {
          "name": "Reject",
          "from": "PendingApproval",
          "to": "Rejected",
          "guard": {
            "kind": "always"
          },
          "approvals": {
            "quorum": 1,
            "roles": [
              "manager",
              "controller"
            ],
            "distinct_actors": true,
            "expires_in": "72h"
          },
          "effects": [
            {
              "kind": "set_state",
              "value": "Rejected"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        }
      ]
    },
    {
      "name": "GoodsReceivedFlow",
      "on_entity": "GoodsReceived",
      "state_field": "state",
      "states": [
        {
          "name": "Pending",
          "initial": true,
          "terminal": false
        },
        {
          "name": "Confirmed",
          "initial": false,
          "terminal": true
        },
        {
          "name": "Disputed",
          "initial": false,
          "terminal": false
        }
      ],
      "transitions": [
        {
          "name": "Confirm",
          "from": "Pending",
          "to": "Confirmed",
          "guard": {
            "kind": "compare",
            "op": "==",
            "lhs": {
              "ref": "GoodsReceived.condition",
              "type": "unknown"
            },
            "rhs": {
              "lit": "good",
              "type": "string"
            }
          },
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Confirmed"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        },
        {
          "name": "Dispute",
          "from": "Pending",
          "to": "Disputed",
          "guard": {
            "kind": "compare",
            "op": "!=",
            "lhs": {
              "ref": "GoodsReceived.condition",
              "type": "unknown"
            },
            "rhs": {
              "lit": "good",
              "type": "string"
            }
          },
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Disputed"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        },
        {
          "name": "Resolve",
          "from": "Disputed",
          "to": "Confirmed",
          "guard": {
            "kind": "always"
          },
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Confirmed"
            },
            {
              "kind": "bump_version",
              "field": "version",
              "by": 1
            }
          ]
        }
      ]
    }
  ],
