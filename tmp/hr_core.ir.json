  "workflows": [
    {
      "name": "HireRequestFlow",
      "on_entity": "HireRequest",
      "state_field": "state",
      "states": [
        {
          "initial": true,
          "name": "Draft",
          "terminal": false
        },
        {
          "initial": false,
          "name": "PendingApproval",
          "terminal": false
        },
        {
          "initial": false,
          "name": "Approved",
          "terminal": true
        },
        {
          "initial": false,
          "name": "Rejected",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "PendingApproval"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Draft",
          "guard": {
            "kind": "compare",
            "lhs": {
              "ref": "HireRequest.salary_proposed",
              "type": "unknown"
            },
            "op": ">",
            "rhs": {
              "lit": 0,
              "type": "int"
            }
          },
          "name": "Submit",
          "to": "PendingApproval"
        },
        {
          "approvals": {
            "distinct_actors": true,
            "expires_in": "72h",
            "quorum": 1,
            "roles": [
              "manager",
              "controller"
            ]
          },
          "effects": [
            {
              "kind": "set_state",
              "value": "Approved"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "PendingApproval",
          "guard": {
            "kind": "always"
          },
          "name": "Approve",
          "to": "Approved"
        },
        {
          "approvals": {
            "distinct_actors": true,
            "expires_in": "72h",
            "quorum": 1,
            "roles": [
              "manager",
              "controller"
            ]
          },
          "effects": [
            {
              "kind": "set_state",
              "value": "Rejected"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "PendingApproval",
          "guard": {
            "kind": "always"
          },
          "name": "Reject",
          "to": "Rejected"
        }
      ]
    },
    {
      "name": "CandidateFlow",
      "on_entity": "Candidate",
      "state_field": "state",
      "states": [
        {
          "initial": true,
          "name": "Active",
          "terminal": false
        },
        {
          "initial": false,
          "name": "Hired",
          "terminal": true
        },
        {
          "initial": false,
          "name": "Rejected",
          "terminal": true
        },
        {
          "initial": false,
          "name": "Withdrawn",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Hired"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Active",
          "guard": {
            "kind": "compare",
            "lhs": {
              "ref": "Candidate.state",
              "type": "unknown"
            },
            "op": "==",
            "rhs": {
              "lit": "Active",
              "type": "string"
            }
          },
          "name": "MarkHired",
          "to": "Hired"
        },
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Rejected"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Active",
          "guard": {
            "kind": "compare",
            "lhs": {
              "ref": "Candidate.state",
              "type": "unknown"
            },
            "op": "==",
            "rhs": {
              "lit": "Active",
              "type": "string"
            }
          },
          "name": "MarkRejected",
          "to": "Rejected"
        },
        {
          "approvals": null,
          "effects": [
            {
              "kind": "set_state",
              "value": "Withdrawn"
            },
            {
              "by": 1,
              "field": "version",
              "kind": "bump_version"
            }
          ],
          "from": "Active",
          "guard": {
            "kind": "compare",
            "lhs": {
              "ref": "Candidate.state",
              "type": "unknown"
            },
            "op": "==",
            "rhs": {
              "lit": "Active",
              "type": "string"
            }
          },
          "name": "MarkWithdrawn",
          "to": "Withdrawn"
        }
      ]
    }
  ]
}